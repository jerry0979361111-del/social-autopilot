# ===== 必填 =====
# Vercel 部署後的正式網址（不要加結尾斜線）
NEXT_PUBLIC_BASE_URL=https://xxxx.vercel.app
# notion.so/my-integrations 建立的 Internal 整合金鑰
NOTION_API_KEY=ntn_xxx
# Notion 資料庫網址中 ? 前面的 32 碼
NOTION_POSTS_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# platform.openai.com → API keys
OPENAI_API_KEY=sk-xxx
# developers.facebook.com → 你的 App → 設定 → 基本資料
META_APP_ID=
META_APP_SECRET=
# 若 App 用的是「Facebook Login for Business」，填它的「設定」編號（Configuration ID）
META_CONFIG_ID=
# 自訂一段長亂數，cron 呼叫發布端點時要帶上
CRON_SECRET=

# 圖片儲存：在 Vercel 專案 → Storage 建立 Blob 並連接，會自動加入這個變數
# BLOB_READ_WRITE_TOKEN=

# ===== 品牌（建議填，留空用預設值）=====
BRAND_NAME=
BRAND_NAME_EN=
BRAND_COLOR_PRIMARY=#1B3A5C
BRAND_COLOR_SECONDARY=#F2A65A
BRAND_STYLE=
BRAND_TONE=
# 目標受眾、品牌背景、官網（會餵給 AI 產文）
BRAND_AUDIENCE=
BRAND_ABOUT=
BRAND_WEBSITE=
NEXT_PUBLIC_AUTOMATION_DEFAULT_NAME=
NEXT_PUBLIC_AUTOMATION_DEFAULT_THEME=

# ===== 選填 =====
# 幫網站加一道登入密碼
APP_PASSWORD=
# 預設 gpt-4.1-mini / gpt-image-1
OPENAI_TEXT_MODEL=
OPENAI_IMAGE_MODEL=
